# Environment variable NAMES for the BGMI registration server.
# Copy the ones you need into your shell / process environment — the server
# reads plain environment variables (there is no .env auto-loader), and this
# file deliberately lists names only: no values are ever committed.
# PowerShell: $env:PORT='9000'   cmd.exe: set PORT=9000

# Server bind
HOST
PORT

# Storage
BGMI_DB
BGMI_UPLOADS
BGMI_SLOT_LIMIT

# Rate limits (requests per window, window in seconds)
BGMI_RATE_LIMIT
BGMI_RATE_WINDOW
BGMI_STATUS_RATE_LIMIT
BGMI_STATUS_RATE_WINDOW

# Admin sessions (seconds)
BGMI_SESSION_TTL
BGMI_SESSION_IDLE_TTL

# Admin account creation (scripts/create_admin.py)
BGMI_ADMIN_USER
BGMI_ADMIN_PASSWORD

# E-mail notifications (optional; SMTP unset = jobs marked skipped)
BGMI_SMTP_HOST
BGMI_SMTP_PORT
BGMI_SMTP_USER
BGMI_SMTP_PASS
BGMI_SMTP_FROM
BGMI_NOTIFY_ATTEMPTS
BGMI_NOTIFY_POLL

# Tests only
BASE
BGMI_RATE_LIMIT_TEST
